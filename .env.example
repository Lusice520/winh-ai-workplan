# 复制为 .env 后，只在当前电脑保存本地开发配置；不要提交 .env。
SERVER_ADDRESS=127.0.0.1
SERVER_PORT=8080

# 前端开发服务器固定使用 127.0.0.1:5173，/api 代理到 127.0.0.1:8080。

# 项目本地 PostgreSQL。执行 `pnpm database:start` 会在 127.0.0.1:54329 创建此数据库和用户。
DATABASE_HOST=127.0.0.1
DATABASE_PORT=54329
DATABASE_NAME=winh_workplan
DATABASE_USERNAME=winh
DATABASE_PASSWORD=

# 仅空数据库首次启动时使用。请在本机 .env 中填写一个至少 12 位的管理员密码；示例文件不提供默认密码。
APP_BOOTSTRAP_ADMIN_LOGIN=admin
APP_BOOTSTRAP_ADMIN_PASSWORD=
APP_BOOTSTRAP_ADMIN_DISPLAY_NAME=本地管理员
APP_BOOTSTRAP_ORGANIZATION_NAME=本地示例组织

# 本地 HTTP 开发可为 false；生产环境必须使用 HTTPS 并设为 true。
APP_SESSION_COOKIE_SECURE=false

# 可选私有 S3；留空时文件传输明确不可用。真实凭证只放在本机 .env 或部署密钥管理中。
FILE_S3_ENDPOINT=
FILE_S3_REGION=us-east-1
FILE_S3_BUCKET=winh-project-files
FILE_S3_ACCESS_KEY=
FILE_S3_SECRET_KEY=
FILE_MAX_BYTES=20971520
